{
  "expo": {
    "name": "InspectPro",
    "slug": "inspectpro",
    "version": "0.4.1",
    "runtimeVersion": { "policy": "appVersion" },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jargile.inspectpro",
      "infoPlist": {
        "NSCameraUsageDescription": "InspectPro uses the camera for guided inspection photo capture.",
        "NSLocationWhenInUseUsageDescription": "InspectPro can record the inspection location with photos to document the risk address.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "permissions": ["android.permission.CAMERA"],
      "adaptiveIcon": {
        "backgroundColor": "#1b1f4e",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "supabaseUrl": "https://grbycumzzbbdhdbtujtf.supabase.co",
      "supabaseAnonKey": "sb_publishable_fw-p5yH_qSWWmY70VOHHCA_OPHR6m2s"
    },
    "plugins": [
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "InspectPro uses the camera for guided inspection photo capture.",
          "enableMicrophonePermission": false,
          "enableLocation": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "InspectPro attaches diagrams, Sketch AR screenshots, and CAD markups from your photo library to the claim package."
        }
      ]
    ]
  }
}
